# PostgreSQL — use a Neon project (https://neon.tech) or any Postgres.
#
# DATABASE_URL: pooled connection, used by the app at runtime (serverless
#   functions open/close connections often, so this must go through Neon's
#   PgBouncer pooler). Append `?pgbouncer=true&connect_timeout=15` to Neon's
#   pooled connection string.
# DIRECT_URL: unpooled connection, used only by `prisma migrate`.
#
# For local dev with the docker-compose Postgres, both can be the same value.
DATABASE_URL=postgresql://joobot:joobot@localhost:5432/joobot
DIRECT_URL=postgresql://joobot:joobot@localhost:5432/joobot

# Key used to encrypt WhatsApp access tokens / app secrets at rest.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=change-me-generate-a-32-byte-base64-key

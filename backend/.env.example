# PostgreSQL connection used by the app (async driver)
DATABASE_URL=postgresql+asyncpg://joobot:joobot@localhost:5432/joobot

# Fernet key used to encrypt WhatsApp access tokens / app secrets at rest.
# Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=change-me-generate-a-fernet-key

# Comma-separated list of origins allowed to call the API (the frontend URL)
CORS_ORIGINS=http://localhost:3000

# Default WhatsApp Cloud API version to use when sending/receiving messages
META_API_VERSION=v21.0
